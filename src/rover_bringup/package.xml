  <exec_depend>joy</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav2_map_server</exec_depend><exec_depend>rviz2</exec_depend>
