<?xml version="1.0"?>
<package format="3">
  <name>rover_bringup</name><version>0.2.0</version>
  <description>Image-derived maze, Cartographer and gamepad operation for the IRC rover.</description>
  <maintainer email="inian@example.com">Inian</maintainer>
  <license>LicenseRef-Proprietary</license>
  <build_depend>python3-setuptools</build_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
